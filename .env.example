# Zoho OAuth2 (from Zoho Developer Console)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho Books organization ID (required for API calls)
ZOHO_ORG_ID=

# Region: US | EU | IN | AU | JP | CA (default: US)
ZOHO_REGION=US

# Safety: read-only mode enabled by default.
# Set to 0/false/off to enable write tools.
ZOHO_READ_ONLY=1
